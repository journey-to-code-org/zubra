---
import HelloCounter from '../components/hello-counter.zb';
import ZubraWelcome from '../components/zubra-welcome.zb';
import ZubraExamples from '../components/zubra-examples.zb';
import '../style.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>{{title}}</title>
  </head>
  <body>
    <main>
      <ZubraWelcome heading="{{title}}" framework="Astro" />
      <section class="try">
        <HelloCounter label="Clicks" client:load />
        <p>The page sees <span id="seen">0</span></p>
      </section>
      <ZubraExamples client:load />
    </main>
    <script>
      document.querySelector('hello-counter').addEventListener('countchange', (event) => {
        document.querySelector('#seen').textContent = event.detail;
      });
    </script>
  </body>
</html>
