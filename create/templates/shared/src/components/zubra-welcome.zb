<!--
  The top of the starter page: the logo, the app's name and where to begin. It's only here to
  greet you. When you start on your own page, delete this file and zubra-examples.zb, and take
  their two tags out of the page.
-->
<style>
  :host { display: grid; justify-items: center; gap: 0.75rem; text-align: center; }
  .zw-mark { display: block; width: 5.5rem; height: 5.5rem; border-radius: 1.3rem; transition: filter 0.3s; }
  .zw-mark:hover { filter: drop-shadow(0 0 1.5rem #4f5df5aa); }
  .zw-mark svg { display: block; width: 100%; height: 100%; }
  h1 { margin: 0.5rem 0 0; font-size: clamp(1.8rem, 5vw, 2.6rem); line-height: 1.1; letter-spacing: -0.02em; }
  p { margin: 0; color: var(--muted, #5d6375); }
  code { font: 0.9em ui-monospace, SFMono-Regular, Menlo, monospace; padding: 0.15em 0.4em; border-radius: 0.3em; background: var(--code, #e9ebf3); color: var(--text, #1d2130); }
</style>
<zubra-welcome heading="Zubra app" framework="" reloads={false}>
  <a
    class="zw-mark"
    href="https://github.com/journey-to-code-org/zubra"
    target="_blank"
    rel="noreferrer"
    aria-label="Zubra on GitHub"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96" aria-hidden="true"><rect x="4" y="4" width="88" height="88" rx="22" fill="#4f5df5" /><g transform="translate(19.2 19.2) scale(0.6)"><path fill="#fff" d="M15 10 H81 a5 5 0 0 1 5 5 V27 L42 69 H86 V81 a5 5 0 0 1 -5 5 H15 a5 5 0 0 1 -5 -5 V69 H10 L54 27 H10 V15 a5 5 0 0 1 5 -5 Z" /></g></svg>
  </a>
  <h1>{heading}</h1>
  <p zb-if={framework}>Zubra components, used from {framework}.</p>
  <p zb-else>Zubra components in plain HTML.</p>
  <p zb-if={reloads}>Edit <code>src/components/hello-counter.zb</code>, save, and reload the page.</p>
  <p zb-else>Edit <code>src/components/hello-counter.zb</code> and save: it updates in place and keeps its count.</p>
</zubra-welcome>
