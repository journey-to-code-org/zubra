{
  "name": "counter-slice-webui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "webui build ./src --out ./dist --plugin=webui --dom=light && esbuild src/index.ts --bundle --minify --format=esm --outfile=dist/client.js",
    "start": "NODE_ENV=production node server.js"
  },
  "dependencies": {
    "@microsoft/webui": "3.1.2",
    "@microsoft/webui-framework": "3.1.2",
    "counter-slice-backend": "file:../shared"
  },
  "devDependencies": { "esbuild": "0.28.2" }
}
